{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=guardrail;Username=guardrail;Password=guardrail"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "http://localhost:5080"
  },
  "PayPal": {
    "AllowMissingCredentials": true,
    "ReturnUrl": "http://localhost:5173/checkout/return",
    "CancelUrl": "http://localhost:5173/checkout/cancel"
  },
  "Seed": {
    "CreateDemoUser": true
  },
  "Demo": {
    "ResetEnabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  }
}
