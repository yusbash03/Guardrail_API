{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "https://api.guardrail.example",
    "Audience": "guardrail-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "Intent": "AUTHORIZE",
    "BrandName": "Guardrail AI",
    "ReturnUrl": "https://guardrail.vercel.app/checkout/return",
    "CancelUrl": "https://guardrail.vercel.app/checkout/cancel"
  },
  "Llm": {
    "Primary": {
      "Provider": "Gemini",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "Model": "",
      "RequestsPerMinute": 8
    },
    "Fallback": {
      "Provider": "Groq",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "Model": "openai/gpt-oss-120b",
      "RequestsPerMinute": 25
    },
    "TimeoutSeconds": 30
  },
  "Agent": {
    "MaxLlmRequestsPerTurn": 6,
    "MaxToolCallsPerTurn": 16,
    "TurnTimeoutSeconds": 60
  },
  "Approvals": {
    "TtlMinutes": 30,
    "StepUpMaxFailures": 5
  },
  "Evaluations": {
    "MaxAgeMinutes": 15
  },
  "Checkout": {
    "PayPalApprovalTimeoutHours": 3,
    "AuthorizationMaxOpenMinutes": 30
  },
  "Jobs": {
    "Enabled": true
  },
  "Seed": {
    "Catalogue": true,
    "CreateDemoUser": false
  },
  "Demo": {
    "ResetEnabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
